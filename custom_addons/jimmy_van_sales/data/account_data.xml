<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Plazos de pago -->
        <record id="payment_term_contado" model="account.payment.term">
            <field name="name">Contado</field>
            <field name="line_ids" eval="[(5, 0, 0), (0, 0, {
                'value': 'percent',
                'value_amount': 100.0,
                'nb_days': 0,
                'delay_type': 'days_after',
            })]"/>
        </record>

        <record id="payment_term_credito_15" model="account.payment.term">
            <field name="name">Crédito 15 días</field>
            <field name="line_ids" eval="[(5, 0, 0), (0, 0, {
                'value': 'percent',
                'value_amount': 100.0,
                'nb_days': 15,
                'delay_type': 'days_after',
            })]"/>
        </record>

        <!-- Diarios de efectivo, uno por vehiculo -->
        <record id="journal_efectivo_veh1" model="account.journal">
            <field name="name">Efectivo Cesar Gomez</field>
            <field name="code">EFV1</field>
            <field name="type">cash</field>
        </record>

        <record id="journal_efectivo_veh2" model="account.journal">
            <field name="name">Efectivo Luis Melo</field>
            <field name="code">EFV2</field>
            <field name="type">cash</field>
        </record>

        <record id="journal_efectivo_veh3" model="account.journal">
            <field name="name">Efectivo Andres Gutierrez</field>
            <field name="code">EFV3</field>
            <field name="type">cash</field>
        </record>

    </data>
</odoo>
